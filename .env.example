# AI Karmayogi Prototype v2.0 Configuration
# LLM Provider: 'auto', 'gemini', 'openai', or 'offline_engine'
LLM_PROVIDER=auto

# Optional API Keys (Leave blank to use the built-in grounded civil service synthesis engine)
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Model Name
LLM_MODEL=gemini-2.5-flash

# Database & Retrieval
DATABASE_URL=sqlite:///./karmayogi.db
TOP_K_RETRIEVAL=4
